{
    "configurations": [
        {
            "name": "Lox.Compiler.App",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: build debug",
            "program": "${workspaceFolder}/Lox.Compiler.App/bin/Debug/net8.0/win-x64/loxc.dll",
            "args": [
                "program.lox"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole",
            "logging": {
                "moduleLoad": false
            },
            "env": {
                "DOTNET_NOLOGO": "yes",
                "DOTNET_CLI_TELEMETRY_OPTOUT": "yes"
            }
        }
    ]
}